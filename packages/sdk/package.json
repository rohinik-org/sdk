{
  "name": "@rohinik-org/sdk",
  "version": "0.15.0",
  "private": true,
  "type": "module",
  "description": "Rohinik SDK — high-level client facade for the RS-1 runtime",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@rohinik-org/runtime-client": "link:../../../../rs1/core/runtime/client",
    "@rohinik-org/agent": "link:../../../../rs1/core/runtime/agent",
    "@rohinik-org/agent-protocol-v1": "link:../../../../rs1/core/protocol/agent-v1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "*",
    "typescript": "*",
    "vitest": "*"
  }
}
