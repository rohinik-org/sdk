{
  "name": "@rohinik-org/client",
  "version": "0.16.0-beta.1",
  "license": "Apache-2.0",
  "type": "module",
  "description": "Rohinik async execution client — protocol types bundled, no runtime dependencies",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --no-splitting --external node:crypto --external node:http",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {},
  "devDependencies": {
    "@rohinik-org/execution-protocol-v1": "file:./vendor/rohinik-org-execution-protocol-v1-1.0.0.tgz",
    "@types/node": "^22.0.0",
    "tsup": "*",
    "typescript": "*",
    "vitest": "*"
  }
}
