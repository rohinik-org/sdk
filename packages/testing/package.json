{
  "name": "@rohinik-org/testing",
  "version": "0.16.0-beta.1",
  "license": "Apache-2.0",
  "type": "module",
  "description": "Rohinik testing utilities \u00e2\u20ac\u201d deterministic fixtures for Rohinik public contracts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly --declaration --outDir dist",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@rohinik-org/capability-sdk": "file:./vendor/rohinik-org-capability-sdk-0.16.0.tgz",
    "@rohinik-org/agent-sdk": "file:./vendor/rohinik-org-agent-sdk-0.16.0.tgz",
    "@rohinik-org/provider-sdk": "file:./vendor/rohinik-org-provider-sdk-0.16.0.tgz",
    "@rohinik-org/package-sdk": "file:./vendor/rohinik-org-package-sdk-0.16.0.tgz",
    "@rohinik-org/client": "file:./vendor/rohinik-org-client-1.0.0.tgz",
    "@types/node": "^22.0.0",
    "tsup": "*",
    "typescript": "*",
    "vitest": "*"
  }
}